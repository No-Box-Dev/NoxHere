{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noxalert",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 30000 },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "d1_databases": [
    {
      "binding": "NOX_DB",
      "database_name": "unticket",
      "database_id": "c94084e6-d0be-423c-8de6-249e7cf8bf25"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "NOX_TASKS", "queue": "unticket-tasks" }
    ]
  },
  "ratelimits": [
    {
      "name": "ERROR_IP_RATE_LIMITER",
      "namespace_id": "9137001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "ERROR_PROJECT_RATE_LIMITER",
      "namespace_id": "9137002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RULE_EVALUATORS", "class_name": "RuleEvaluator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RuleEvaluator"] }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CANARY_OWNER_ID": "No-Box-Dev"
  }
}
