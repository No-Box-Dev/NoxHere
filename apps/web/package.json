{
  "name": "@noxhere/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/check-node-version.mjs && vite --host 127.0.0.1",
    "dev:backend": "node ../../scripts/check-node-version.mjs && node scripts/dev-backend.mjs",
    "build": "node ../../scripts/check-node-version.mjs && tsc -b && vite build",
    "preview": "node ../../scripts/check-node-version.mjs && vite preview --host 127.0.0.1",
    "typecheck": "node ../../scripts/check-node-version.mjs && tsc -b --pretty false",
    "lint": "node ../../scripts/check-node-version.mjs && eslint . && npm run boundaries",
    "boundaries": "node ../../scripts/check-node-version.mjs && node scripts/check-boundaries.mjs",
    "docs:cli-check": "node ../../scripts/check-node-version.mjs && node ../../scripts/check-cli-docs.mjs",
    "docs:stale-check": "node ../../scripts/check-node-version.mjs && node ../../scripts/check-public-docs.mjs",
    "docs:check": "node ../../scripts/check-node-version.mjs && npm run docs:cli-check && npm run docs:stale-check",
    "test": "node ../../scripts/check-node-version.mjs && vitest run",
    "test:watch": "node ../../scripts/check-node-version.mjs && vitest",
    "test:e2e": "node ../../scripts/check-node-version.mjs && playwright test",
    "test:e2e:widget": "node ../../scripts/check-node-version.mjs && npm --prefix ../../packages/feedback-widget run build && playwright test --config=playwright.widget.config.ts",
    "check": "node ../../scripts/check-node-version.mjs && npm run typecheck && npm run lint && npm run docs:check && npm run test && npm run build",
    "preinstall": "node ../../scripts/check-node-version.mjs"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.90.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
