#!/usr/bin/env bash
# Render every icon asset from the canonical SVG sources.
# Mirrors NoxKey's `generate-app-icon` script — one bold SVG per target,
# rsvg-convert rasterizes to every size the asset catalog expects.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
APP_SRC="$SCRIPT_DIR/icon-sources/app-icon.svg"
IOS_APP_SRC="$SCRIPT_DIR/icon-sources/app-icon-ios.svg"
MENU_SRC="$SCRIPT_DIR/icon-sources/menubar-icon.svg"
APP_OUT="$ROOT/NoxHere/Assets.xcassets/AppIcon.appiconset"
MENU_OUT="$ROOT/NoxHere/Assets.xcassets/MenuBarIcon.imageset"

command -v rsvg-convert >/dev/null || {
  echo "rsvg-convert not installed (brew install librsvg)" >&2
  exit 1
}

mkdir -p "$APP_OUT" "$MENU_OUT"

render() {
  local src=$1 size=$2 out=$3
  rsvg-convert --width="$size" --height="$size" "$src" --output="$out"
  echo "  $out (${size}x${size})"
}

echo "App icon →"
render "$APP_SRC" 16   "$APP_OUT/icon_16x16.png"
render "$APP_SRC" 32   "$APP_OUT/icon_16x16@2x.png"
render "$APP_SRC" 32   "$APP_OUT/icon_32x32.png"
render "$APP_SRC" 64   "$APP_OUT/icon_32x32@2x.png"
render "$APP_SRC" 128  "$APP_OUT/icon_128x128.png"
render "$APP_SRC" 256  "$APP_OUT/icon_128x128@2x.png"
render "$APP_SRC" 256  "$APP_OUT/icon_256x256.png"
render "$APP_SRC" 512  "$APP_OUT/icon_256x256@2x.png"
render "$APP_SRC" 512  "$APP_OUT/icon_512x512.png"
render "$APP_SRC" 1024 "$APP_OUT/icon_512x512@2x.png"
render "$IOS_APP_SRC" 1024 "$APP_OUT/icon_ios_1024x1024.png"

echo "Menu bar icon (template) →"
render "$MENU_SRC" 22 "$MENU_OUT/menubar-icon.png"
render "$MENU_SRC" 44 "$MENU_OUT/menubar-icon@2x.png"

echo "Done."
