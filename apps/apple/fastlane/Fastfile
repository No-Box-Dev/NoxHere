require 'json'
require 'base64'
require 'shellwords'
require 'yaml'
require 'rbconfig'

# Keep formatter and helper subprocesses on the Ruby that launched Fastlane.
# macOS still ships an old /usr/bin/ruby, which is incompatible with the
# Bundler environment used by this project when `xcpretty` is spawned.
ruby_bin = RbConfig::CONFIG.fetch('bindir')
ENV['PATH'] = "#{ruby_bin}:#{ENV.fetch('PATH', '')}" unless ENV.fetch('PATH', '').split(':').first == ruby_bin

default_platform(:mac)

# Local-only App Store workflow — signing certs and the ASC API key stay off
# CI for security. Before any lane that talks to App Store Connect, export:
#
#   APP_STORE_CONNECT_API_KEY_P8_B64  base64-encoded .p8 file
#   APP_STORE_CONNECT_KEY_ID          key id from ASC API keys page
#   APP_STORE_CONNECT_ISSUER_ID       issuer id from ASC API keys page
#
# The same key already used by NoxKey works for NoxHere (both apps live
# under the same Apple team id GG6633R92T). See fastlane/README.md for the
# noxkey path that stores these three values.

def setup_api_key!
  existing = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  if existing && !existing.empty? && File.exist?(existing)
    UI.success("Using existing App Store Connect API key at #{existing}")
    return
  end

  p8_b64 = ENV["APP_STORE_CONNECT_API_KEY_P8_B64"]
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  if p8_b64.nil? || p8_b64.empty? || key_id.nil? || key_id.empty? || issuer.nil? || issuer.empty?
    UI.user_error!("Missing ASC credentials — export APP_STORE_CONNECT_API_KEY_P8_B64 + _KEY_ID + _ISSUER_ID. See fastlane/README.md.")
  end
  key_path = "/tmp/asc-api-key.json"
  File.write(key_path, JSON.generate({
    key_id: key_id,
    issuer_id: issuer,
    key: Base64.decode64(p8_b64),
    in_house: false,
  }))
  File.chmod(0o600, key_path)
  ENV["APP_STORE_CONNECT_API_KEY_PATH"] = key_path
  ENV["NOXHERE_TEMP_ASC_KEY"] = key_path
  UI.success("App Store Connect API key configured for key #{key_id}")
end

def xcode_auth_args!
  config = JSON.parse(File.read(ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")))
  key_path = "/tmp/noxhere-asc-api-key.p8"
  File.write(key_path, config.fetch("key"))
  File.chmod(0o600, key_path)
  ENV["NOXHERE_TEMP_ASC_P8"] = key_path

  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{Shellwords.escape(key_path)}",
    "-authenticationKeyID #{Shellwords.escape(config.fetch("key_id"))}",
    "-authenticationKeyIssuerID #{Shellwords.escape(config.fetch("issuer_id"))}",
  ].join(" ")
end

platform :ios do
  after_all do
    key_path = ENV.delete("NOXHERE_TEMP_ASC_KEY")
    File.delete(key_path) if key_path && File.exist?(key_path)
    p8_path = ENV.delete("NOXHERE_TEMP_ASC_P8")
    File.delete(p8_path) if p8_path && File.exist?(p8_path)
  end

  error do
    key_path = ENV.delete("NOXHERE_TEMP_ASC_KEY")
    File.delete(key_path) if key_path && File.exist?(key_path)
    p8_path = ENV.delete("NOXHERE_TEMP_ASC_P8")
    File.delete(p8_path) if p8_path && File.exist?(p8_path)
  end

  desc "Create or download the iOS App Store certificate and profile"
  lane :fetch_signing do
    setup_api_key!
    signing_path = "/tmp/noxhere-ios-signing"
    FileUtils.mkdir_p(signing_path)
    get_certificates(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      platform: "ios",
      generate_apple_certs: true,
      output_path: signing_path,
    )
    get_provisioning_profile(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_identifier: "dev.noboxdev.noxfeed",
      platform: "ios",
      provisioning_name: "NoxFeed iOS App Store",
      filename: "NoxHere_iOS_App_Store.mobileprovision",
      output_path: signing_path,
      cert_id: lane_context[SharedValues::CERT_CERTIFICATE_ID],
    )
  end

  private_lane :prepare_store do
    setup_api_key!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
    )

    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("dev.noboxdev.noxfeed")
    UI.user_error!("NoxHere app not found in App Store Connect") unless app

    spec = YAML.safe_load(File.read(File.expand_path("../project.yml", __dir__)))
    version = spec.dig("settings", "base", "MARKETING_VERSION")
    UI.user_error!("NoxHere marketing version is missing from project.yml") unless version
    created = app.ensure_version!(version, platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.success(created ? "Prepared NoxHere iOS #{version} in the existing app record" : "NoxHere iOS #{version} is already prepared")
  end

  desc "Archive and upload NoxHere for iPhone and iPad"
  lane :release do
    setup_api_key!
    auth_args = xcode_auth_args!
    spec = File.expand_path("../project.yml", __dir__)
    sh("xcodegen generate --spec #{spec}")
    prepare_store

    build_app(
      project: "NoxHere.xcodeproj",
      scheme: "NoxHereMobile",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "NoxHere",
      clean: true,
      xcargs: auth_args,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: {
          "dev.noboxdev.noxfeed" => "NoxFeed iOS App Store",
        },
      },
    )

    upload_to_app_store(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      ipa: "build/ios/NoxHere.ipa",
      app_identifier: "dev.noboxdev.noxfeed",
      platform: "ios",
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
    )
  end

  desc "Upload a prebuilt NoxHere iOS .ipa"
  lane :upload_build do |options|
    setup_api_key!
    prepare_store
    ipa = options[:ipa]
    UI.user_error!("Pass ipa:/path/to/NoxHere.ipa") unless ipa
    upload_to_app_store(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      ipa: ipa,
      app_identifier: "dev.noboxdev.noxfeed",
      platform: "ios",
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      submit_for_review: false,
    )
  end

  desc "Show the latest iOS builds' processing state in App Store Connect"
  lane :build_status do
    setup_api_key!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
    )
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("dev.noboxdev.noxfeed")
    UI.user_error!("NoxHere app not found in App Store Connect") unless app
    builds = app.get_builds(
      filter: { "preReleaseVersion.platform" => Spaceship::ConnectAPI::Platform::IOS },
      limit: 5,
    )
    if builds.nil? || builds.empty?
      UI.message("No iOS builds found for NoxHere yet.")
    else
      builds.each do |build|
        UI.message("iOS build #{build.version} | processing_state=#{build.processing_state} | uploaded=#{build.uploaded_date}")
      end
    end
  end

  desc "Upload iOS metadata and screenshots, then submit the latest build for review"
  lane :submit_for_review do
    setup_api_key!
    spec = YAML.safe_load(File.read(File.expand_path("../project.yml", __dir__)))
    version = spec.dig("settings", "base", "MARKETING_VERSION")
    build_number = spec.dig("settings", "base", "CURRENT_PROJECT_VERSION")

    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_identifier: "dev.noboxdev.noxfeed",
      app_version: version,
      build_number: build_number,
      platform: "ios",
      metadata_path: "fastlane/ios_metadata",
      screenshots_path: "fastlane/ios_screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
      },
    )
  end

  desc "Upload iOS metadata and screenshots without submitting"
  lane :prepare_listing do
    setup_api_key!
    spec = YAML.safe_load(File.read(File.expand_path("../project.yml", __dir__)))
    version = spec.dig("settings", "base", "MARKETING_VERSION")

    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_identifier: "dev.noboxdev.noxfeed",
      app_version: version,
      platform: "ios",
      metadata_path: "fastlane/ios_metadata",
      screenshots_path: "fastlane/ios_screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
    )
  end

  desc "Select the prepared iOS build and submit it without replacing listing assets"
  lane :submit_ready_version do
    setup_api_key!
    spec = YAML.safe_load(File.read(File.expand_path("../project.yml", __dir__)))
    version = spec.dig("settings", "base", "MARKETING_VERSION")
    build_number = spec.dig("settings", "base", "CURRENT_PROJECT_VERSION")

    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_identifier: "dev.noboxdev.noxfeed",
      app_version: version,
      build_number: build_number,
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
      },
    )
  end

  desc "Inspect the iOS version localization and screenshot sets"
  lane :listing_status do
    setup_api_key!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
    )
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("dev.noboxdev.noxfeed")
    UI.user_error!("NoxHere app not found in App Store Connect") unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("Editable iOS version not found") unless version
    UI.message("iOS version #{version.version_string} | state=#{version.app_store_state}")
    version.get_app_store_version_localizations.each do |localization|
      UI.message("locale=#{localization.locale} | description_chars=#{localization.description.to_s.length}")
      localization.get_app_screenshot_sets.each do |set|
        UI.message("display_type=#{set.screenshot_display_type} | screenshots=#{set.app_screenshots.to_a.length}")
      end
    end
  end

  desc "Build, upload, and submit the iPhone and iPad companion"
  lane :publish do
    release
    submit_for_review
  end
end

def ensure_release_notes!
  require "spaceship"
  app = Spaceship::ConnectAPI::App.find("dev.noboxdev.noxfeed")
  UI.user_error!("NoxHere app not found in App Store Connect") unless app

  version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::MAC_OS)
  UI.user_error!("No editable macOS version found") unless version

  notes_path = File.expand_path("metadata/en-US/release_notes.txt", __dir__)
  notes = File.read(notes_path).strip
  localizations = version.get_app_store_version_localizations
  UI.user_error!("No localizations found for #{version.version_string}") if localizations.empty?

  localizations.each do |locale|
    locale.update(attributes: { whats_new: notes }) if locale.whats_new.to_s.strip.empty?
  end

  missing = version.get_app_store_version_localizations.select { |locale| locale.whats_new.to_s.strip.empty? }
  UI.user_error!("What's New is still missing for: #{missing.map(&:locale).join(', ')}") unless missing.empty?
  UI.success("Verified What's New for #{version.version_string}: #{localizations.map(&:locale).join(', ')}")
end

platform :mac do
  after_all do
    key_path = ENV.delete("NOXHERE_TEMP_ASC_KEY")
    File.delete(key_path) if key_path && File.exist?(key_path)
  end

  error do
    key_path = ENV.delete("NOXHERE_TEMP_ASC_KEY")
    File.delete(key_path) if key_path && File.exist?(key_path)
  end

  desc "Regenerate the Xcode project from project.yml"
  lane :generate do
    # fastlane runs sh from fastlane/, so point xcodegen at the spec by
    # absolute path — it resolves source paths relative to the spec file.
    spec = File.expand_path("../project.yml", __dir__)
    sh("xcodegen generate --spec #{spec}")
  end

  desc "Archive + export the MAS .pkg only (no upload) — verifies signing/export"
  lane :build_only do
    generate
    build_app(
      project: "NoxHere.xcodeproj",
      scheme: "NoxHere",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "3rd Party Mac Developer Application: Jasper Middendorp (GG6633R92T)",
        installerSigningCertificate: "3rd Party Mac Developer Installer",
        provisioningProfiles: {
          "dev.noboxdev.noxfeed" => "NoxFeed App Store"
        }
      },
      output_directory: "build",
      output_name: "NoxHere",
    )
  end

  desc "Register the App ID + create the ASC app record (run once)"
  lane :create_app do
    setup_api_key!
    # Register the key in the lane session so create_app_online (which has no
    # api_key param) authenticates both portal + ASC with it.
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
      duration: 1_200,
    )
    create_app_online(
      app_identifier: "dev.noboxdev.noxfeed",
      app_name: "NoxHere",
      sku: "noxfeed",
      platform: "osx",
      skip_devcenter: true,
    )
  end

  desc "List App Store Connect app records (name + bundle id)"
  lane :which_app do
    setup_api_key!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
      duration: 1_200,
    )
    require "spaceship"
    apps = Spaceship::ConnectAPI::App.all
    if apps.nil? || apps.empty?
      UI.message("No app records found in App Store Connect.")
    else
      apps.each { |a| UI.message("ASC app: #{a.name}  ->  #{a.bundle_id}") }
    end
  end

  desc "Download the Mac App Store provisioning profile (run once per machine)"
  lane :fetch_profile do
    setup_api_key!
    get_provisioning_profile(
      app_identifier: "dev.noboxdev.noxfeed",
      platform: "macos",
      provisioning_name: "NoxFeed App Store",
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    )
  end

  desc "Recreate the MAS profile cleanly as 'NoxFeed App Store' (run once)"
  lane :reset_profile do
    setup_api_key!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
    )
    require "spaceship"
    bundle = "dev.noboxdev.noxfeed"
    Spaceship::ConnectAPI::Profile.all.select { |p|
      p.bundle_id == bundle || (p.name && p.name.downcase.include?("noxhere"))
    }.each do |p|
      UI.message("Deleting stale MAS profile: #{p.name}")
      p.delete!
    end
    get_provisioning_profile(
      app_identifier: bundle,
      platform: "macos",
      provisioning_name: "NoxFeed App Store",
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
    )
  end

  desc "Build + sign + package the app as a MAS .pkg, upload to ASC"
  lane :release do
    setup_api_key!
    generate

    # Signed for MAS: the Release config signs the app with the "3rd Party
    # Mac Developer Application" cert + the "NoxFeed App Store" profile, and
    # export_options below sign the .pkg installer with the Installer cert.
    # gym (build_app) drives xcodebuild + productbuild.
    build_app(
      project: "NoxHere.xcodeproj",
      scheme: "NoxHere",
      configuration: "Release",
      export_method: "app-store",
      # Automatic signing doesn't reliably resolve the MAS profile during
      # -exportArchive; name it explicitly (sigh creates it as
      # "<bundle_id> AppStore").
      export_options: {
        signingStyle: "manual",
        signingCertificate: "3rd Party Mac Developer Application: Jasper Middendorp (GG6633R92T)",
        installerSigningCertificate: "3rd Party Mac Developer Installer",
        provisioningProfiles: {
          "dev.noboxdev.noxfeed" => "NoxFeed App Store"
        }
      },
      output_directory: "build",
      output_name: "NoxHere",
    )

    # Upload the .pkg without submitting for review — that's a separate step
    # so metadata + screenshots can be pushed independently.
    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      pkg: "build/NoxHere.pkg",
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      platform: "osx",
      submit_for_review: false,
    )
  end

  desc "Push metadata to App Store Connect (no build)"
  lane :push_metadata do
    setup_api_key!
    app_version = get_version_number(xcodeproj: "NoxHere.xcodeproj", target: "NoxHere")
    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false,
      platform: "osx",
    )
    # Fastlane can misclassify the first update after 1.0 as an initial
    # version and skip release_notes. Set the required field explicitly.
    ensure_release_notes!
  end

  desc "Push screenshots to App Store Connect (overwrites existing)"
  lane :push_screenshots do
    setup_api_key!
    app_version = get_version_number(xcodeproj: "NoxHere.xcodeproj", target: "NoxHere")
    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      platform: "osx",
      submit_for_review: false,
    )
  end

  desc "Upload a prebuilt NoxHere .pkg to ASC (pass pkg:/path/to/NoxHere.pkg)"
  lane :upload_build do |options|
    setup_api_key!
    pkg = options[:pkg]
    UI.user_error!("Pass pkg:/path/to/NoxHere.pkg") unless pkg
    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      pkg: pkg,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false,
      platform: "osx",
      submit_for_review: false,
    )
  end

  desc "Show the latest builds' processing state in App Store Connect"
  lane :build_status do
    setup_api_key!
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8_B64"],
      is_key_content_base64: true,
      in_house: false,
    )
    require "spaceship"
    app = Spaceship::ConnectAPI::App.find("dev.noboxdev.noxfeed")
    UI.user_error!("NoxHere app not found in App Store Connect") unless app
    builds = app.get_builds(limit: 5)
    if builds.nil? || builds.empty?
      UI.message("No builds found for NoxHere yet.")
    else
      builds.each do |b|
        # processing_state: -1 invalid, 0 processing, 1 processed/valid
        UI.message("Build #{b.version} | processing_state=#{b.processing_state} | uploaded=#{b.uploaded_date}")
      end
    end
  end

  desc "Submit the latest uploaded build for App Store review"
  lane :submit_for_review do
    setup_api_key!
    app_version = get_version_number(xcodeproj: "NoxHere.xcodeproj", target: "NoxHere")
    deliver(
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      app_version: app_version,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      # App Review leaves a rejected submission in UNRESOLVED_ISSUES. Close
      # that stale container before creating the replacement submission.
      reject_if_possible: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      platform: "osx",
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false,
      },
    )
  end

  desc "Full publish: metadata + screenshots + build + submit for review"
  lane :publish_next do
    push_metadata
    push_screenshots
    release
    submit_for_review
  end
end
