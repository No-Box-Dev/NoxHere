{
  "name": "noxhere",
  "private": true,
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:full": "npm run build:web && npm --prefix services/gateway exec wrangler -- dev",
    "cli": "node apps/cli/noxconnect.mjs",
    "test:cli": "npm --prefix apps/cli test",
    "dev:mirror-playnist": "node scripts/sync-playnist-data-local.mjs",
    "milestones:list": "node scripts/run-platform-milestones.mjs --list",
    "milestones:verify": "node scripts/run-platform-milestones.mjs",
    "milestones:verify:all": "node scripts/run-platform-milestones.mjs --all",
    "health:service-rpc": "node scripts/check-service-rpc.mjs",
    "health:noxticket-data": "node scripts/check-noxticket-data.mjs",
    "health:noxcue-capability": "node scripts/check-noxcue-capability.mjs",
    "health:noxfeed-policy": "node scripts/check-noxfeed-policy.mjs",
    "health:noxspot-runtime": "node scripts/check-noxspot-runtime.mjs",
    "health:boundaries": "node scripts/check-product-boundaries.mjs",
    "e2e:local": "npm run build:web && node scripts/local-e2e.mjs",
    "e2e:provider": "node --env-file-if-exists=.env.staging-acceptance scripts/staging-acceptance.mjs",
    "e2e:provider:preflight": "node --env-file-if-exists=.env.staging-acceptance scripts/staging-acceptance.mjs --preflight",
    "e2e:staging": "npm run e2e:provider",
    "e2e:staging:preflight": "npm run e2e:provider:preflight",
    "build": "npm run build:web && npm run build:gateway",
    "build:web": "npm --prefix apps/web run build",
    "build:gateway": "npm --prefix services/gateway run build",
    "build:api-gateway": "wrangler pages functions build functions --outdir workers/api-gateway/.generated --fallback-service ASSETS",
    "test:project-router": "npm run build:api-gateway && node scripts/test-incident-pages-router.mjs",
    "test:incident-router": "npm run test:project-router",
    "deploy:api-gateway": "npm run build:api-gateway && wrangler deploy --config workers/api-gateway/wrangler.jsonc --env=\"\"",
    "deploy:api-gateway:staging": "npm run build:api-gateway && wrangler deploy --config workers/api-gateway/wrangler.jsonc --env=staging",
    "deploy:capabilities": "wrangler deploy --config services/connect/wrangler.jsonc --env=\"\"",
    "deploy:capabilities:staging": "wrangler deploy --config services/connect/wrangler.jsonc --env=staging",
    "deploy:scheduler:staging": "wrangler deploy --config services/scheduler/wrangler.toml --env=staging",
    "deploy:noxhere": "npm run build:web && npm --prefix services/gateway run deploy:production",
    "deploy:noxhere:staging": "npm run build:web && npm --prefix services/gateway run deploy:staging",
    "deploy:noxspot:staging": "npm --prefix services/spot run types -- --env staging && wrangler deploy --config services/spot/wrangler.jsonc --env=staging",
    "deploy:legacy-bridge": "wrangler deploy --config workers/legacy-bridge/wrangler.jsonc",
    "test:legacy-bridge": "vitest run --config workers/legacy-bridge/vitest.config.ts",
    "openapi:standardize": "node scripts/standardize-openapi.mjs",
    "openapi:check": "node scripts/standardize-openapi.mjs --check",
    "docs:cli-check": "node scripts/check-cli-docs.mjs",
    "docs:stale-check": "node scripts/check-public-docs.mjs",
    "docs:check": "npm run openapi:check && npm run docs:cli-check && npm run docs:stale-check && vitest run functions/api/__tests__/developer-docs.test.js functions/api/__tests__/openapi-capabilities.test.ts functions/api/__tests__/openapi-routes.test.js functions/api/__tests__/client-api-parity.test.js",
    "typecheck": "npm --prefix apps/web run typecheck",
    "typecheck:functions": "tsc -p tsconfig.functions.json",
    "lint": "eslint .",
    "preview": "npm --prefix apps/web run preview",
    "slack:validate": "node scripts/slack-manifest.mjs validate",
    "slack:create": "node scripts/slack-manifest.mjs create",
    "slack:push": "node scripts/slack-manifest.mjs push",
    "migrate:noxspot": "node scripts/migrate-noxspot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "npm --prefix apps/web test",
    "test:gateway": "npm --prefix services/gateway test",
    "test:ticket": "npm --prefix services/ticket test",
    "test:feed": "npm --prefix services/feed test",
    "test:noxspot-capture": "npm --prefix services/spot test",
    "typecheck:noxspot-capture": "npm --prefix services/spot exec tsc -- --noEmit",
    "build:noxspot-capture": "npm --prefix services/spot run build"
  },
  "dependencies": {
    "@noxcue/sdk": "0.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
