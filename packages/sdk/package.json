{
  "name": "@noxhere/sdk",
  "version": "0.2.6",
  "description": "Unified TypeScript SDK for every NoxHere resource",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No-Box-Dev/NoxHere.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js"
    },
    "./growth": {
      "types": "./dist/growth.d.ts",
      "import": "./dist/growth.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "import": "./dist/usage.js"
    },
    "./issues": {
      "types": "./dist/issues.d.ts",
      "import": "./dist/issues.js"
    },
    "./incidents": {
      "types": "./dist/incidents.d.ts",
      "import": "./dist/incidents.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "import": "./dist/stats.js"
    },
    "./telemetry/browser": {
      "types": "./dist/telemetry/browser.d.ts",
      "import": "./dist/telemetry/browser.js"
    },
    "./telemetry/server": {
      "types": "./dist/telemetry/server.d.ts",
      "import": "./dist/telemetry/server.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js"
    }
  },
  "scripts": {
    "generate": "node ../../scripts/check-node-version.mjs && node scripts/generate-operations.mjs",
    "generate:check": "node ../../scripts/check-node-version.mjs && node scripts/generate-operations.mjs --check",
    "build": "node ../../scripts/check-node-version.mjs && npm run generate:check && tsc -p tsconfig.json",
    "check": "node ../../scripts/check-node-version.mjs && npm run generate:check && tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/check-node-version.mjs && npm run generate:check && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "openapi-typescript": "7.12.0",
    "pyright": "1.1.414",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
