{
  "name": "@noxhere/feedback-widget",
  "version": "0.1.0",
  "description": "NoxHere feedback capture widget",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No-Box-Dev/NoxHere.git",
    "directory": "packages/feedback-widget"
  },
  "scripts": {
    "build": "node ../../scripts/check-node-version.mjs && npm run build:loader && npm run build:core",
    "build:loader": "node ../../scripts/check-node-version.mjs && esbuild src/loader.js --bundle --minify --outfile=dist/feedback.min.js --format=iife --global-name=Feedback",
    "build:core": "node ../../scripts/check-node-version.mjs && esbuild src/core-entry.js --bundle --minify --outfile=dist/feedback-core.min.js --format=iife",
    "test": "node ../../scripts/check-node-version.mjs && vitest run",
    "preinstall": "node ../../scripts/check-node-version.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "4.1.11",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
