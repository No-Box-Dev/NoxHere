{
  "name": "@noxhere/ticket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run cf-typegen && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "cf-typegen": "wrangler types worker-configuration.d.ts",
    "db:migrate:staging": "wrangler d1 migrations apply noxticket-staging --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply noxticket --remote",
    "deploy:staging": "npm run db:migrate:staging && wrangler deploy --env staging",
    "deploy:production": "npm run db:migrate:production && wrangler deploy"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
