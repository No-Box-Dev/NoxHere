{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noxhere-api",
  "main": ".generated/index.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "PLATFORM_ADMIN_GITHUB_IDS": "196446605",
    "SLACK_APP_ID": "A0BQAKAPG2Y",
    "BUILD_SHA": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noxhere",
      "database_id": "c94084e6-d0be-423c-8de6-249e7cf8bf25",
      "migrations_dir": "../../migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "noxhere-tasks" }
    ]
  },
  "services": [
    { "binding": "FEEDBACK_RESPONSE", "service": "noxhere-feedback" },
    { "binding": "NOXHERE_EMAIL", "service": "noxhere-connections" },
    { "binding": "PLANNING_SERVICE", "service": "noxhere-planning" },
    { "binding": "TELEMETRY_RESPONSE", "service": "noxhere-telemetry" },
    { "binding": "TELEMETRY_INGEST", "service": "noxhere-telemetry" },
    { "binding": "ACTIVITY_RESPONSE", "service": "noxhere-activity" }
  ],
  "r2_buckets": [
    { "binding": "SPEC_ATTACHMENTS", "bucket_name": "noxhere-spec-attachments" },
    { "binding": "FEEDBACK_ASSETS", "bucket_name": "feedback-assets" }
  ],
  "env": {
    "staging": {
      "name": "noxhere-api-staging",
      "vars": {
        "PLATFORM_ADMIN_GITHUB_IDS": "196446605",
        "SLACK_APP_ID": "A0BQAKAPG2Y",
        "BUILD_SHA": "development"
      },
      "services": [
        { "binding": "FEEDBACK_RESPONSE", "service": "noxhere-feedback-staging" },
        { "binding": "NOXHERE_EMAIL", "service": "noxhere-connections-staging" },
        { "binding": "PLANNING_SERVICE", "service": "noxhere-planning-staging" },
        { "binding": "TELEMETRY_RESPONSE", "service": "noxhere-telemetry-staging" },
        { "binding": "TELEMETRY_INGEST", "service": "noxhere-telemetry-staging" },
        { "binding": "ACTIVITY_RESPONSE", "service": "noxhere-activity-staging" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noxhere-staging",
          "database_id": "3a9d9857-c26d-4421-9fbd-b81f474864d3",
          "migrations_dir": "../../migrations"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "TASK_QUEUE", "queue": "noxhere-tasks-staging" }
        ]
      },
      "r2_buckets": [
        { "binding": "SPEC_ATTACHMENTS", "bucket_name": "noxhere-spec-attachments-staging" },
        { "binding": "FEEDBACK_ASSETS", "bucket_name": "feedback-assets-staging" }
      ]
    }
  }
}
