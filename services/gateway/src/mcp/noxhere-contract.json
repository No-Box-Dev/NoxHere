          "status": {
            "type": "string",
            "enum": [
              "open",
              "completed",
              "all"
            ],
            "default": "all",
            "maxLength": 2048
          },
          "featureNumber": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "const": "general"
              }
