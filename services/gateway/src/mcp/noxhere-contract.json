    {
      "name": "spots_get_report",
      "operationId": "getFeedbackReport",
      "path": "/api/v1/feedback/reports/{reportId}",
      "method": "GET",
      "scope": "feedback:read",
      "summary": "Read one feedback report and protected evidence metadata by ID",
      "parameters": [
        {
          "name": "reportId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9:_-]{1,120}$"
          }
        }
      ],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reportId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9:_-]{1,120}$"
          }
        },
        "required": [
          "reportId"
        ]
      },
      "authorizationEvidence": {
        "kind": "verified_runtime_contract_drift",
        "note": "Published OpenAPI omits noxApiToken. Existing gateway scope mapping, connector allowlist, resource lookup, and report/evidence SQL already admit project-bound feedback:read tokens. No authorization expansion is required for this GET. Authenticated staging verification remains required.",
        "sourceCommit": "69985fc1623ccda050d46cb6d03fe9b937a2ddfe",
        "paths": [
          "services/gateway/src/control/auth.ts",
          "functions/lib/api-auth.js",
          "functions/_middleware.js",
          "functions/api/feedback/reports/[id].ts",
          "functions/lib/__tests__/api-auth.test.ts"
        ]
      },
      "domain": "Spots",
      "title": "Get Spot report",
      "description": "Read one widget report and its evidence references.\nUse a known report ID; evidence files are not downloaded."
    },
    {
      "name": "incidents_list",
      "domain": "Incidents",
      "title": "List Incidents",
      "description": "List the latest 50 unresolved runtime incidents.\nThis is a bounded snapshot, not a complete incident history.",
      "operationId": "getProjectIncidents",
      "path": "/api/v1/projects/{projectId}/incidents",
      "method": "GET",
      "scope": "issues:read",
      "summary": "Read project incidents from the existing overview route",
      "parameters": [],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "contextPathParameters": {
        "projectId": "projectId"
      },
      "projection": "incidents",
      "authorizationEvidence": {
        "kind": "verified_runtime_contract_drift",
        "sourceCommit": "69985fc1623ccda050d46cb6d03fe9b937a2ddfe",
        "note": "The existing gateway issues:read mapping and connector GET collection allowlist admit this route. The existing handler binds org and project and limits unresolved errors to 50. Only errors are exposed; metrics and source metadata are discarded. No auth code or token grants are changed. Detail GET remains unsupported.",
        "paths": [
          "services/gateway/src/control/auth.ts",
          "functions/lib/api-auth.js",
          "functions/_middleware.js",
          "functions/api/v1/projects/[id]/incidents.ts",
          "functions/api/telemetry/project-overview.ts"
        ]
      }
    },
