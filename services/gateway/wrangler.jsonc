{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noxhere",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  // app.noxhere.com is an existing dashboard-managed route. Routine Worker
  // deploys intentionally leave it unchanged and require no zone permission.
  "workers_dev": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/github/callback",
      "/auth/email/*",
      "/__noxhere/*",
      "/widget/*",
      "/r2/*",
      "/responses/*",
      "/feedback.min.js",
      "/feedback-core.min.js"
    ]
  },
  "services": [
    {
      "binding": "NOXHERE",
      "service": "noxhere-api"
    },
    {
      "binding": "NOXHERE_IDENTITY",
      "service": "noxhere-connections"
    },
    {
      "binding": "FEEDBACK",
      "service": "noxhere-feedback"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "noxhere-control",
      "database_id": "b4e665cf-6fc9-4547-9f5d-2851d1163703",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://app.noxhere.com"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "staging": {
      "name": "noxhere-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "PUBLIC_APP_ORIGIN": "https://noxhere-staging.jasper-414.workers.dev"
      },
      "services": [
        {
          "binding": "NOXHERE",
          "service": "noxhere-api-staging"
        },
        {
          "binding": "NOXHERE_IDENTITY",
          "service": "noxhere-connections-staging"
        },
        {
          "binding": "FEEDBACK",
          "service": "noxhere-feedback-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "noxhere-control-staging",
          "database_id": "a0b6bb26-5f7a-4b00-8acc-e1210f3ec82e",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
