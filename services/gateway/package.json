{
  "name": "@noxhere/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/check-node-version.mjs && wrangler deploy --dry-run --outdir dist --env=\"\"",
    "cf-typegen": "node ../../scripts/check-node-version.mjs && wrangler types worker-configuration.d.ts",
    "predeploy:production": "node ../../scripts/check-node-version.mjs && node ../../scripts/assert-main-release.mjs",
    "deploy:production": "node ../../scripts/check-node-version.mjs && wrangler deploy --env=\"\"",
    "deploy:staging": "node ../../scripts/check-node-version.mjs && wrangler deploy --env=staging",
    "test": "node ../../scripts/check-node-version.mjs && vitest run",
    "typecheck": "node ../../scripts/check-node-version.mjs && tsc --noEmit",
    "preinstall": "node ../../scripts/check-node-version.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
