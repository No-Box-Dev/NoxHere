{
  "name": "@noxcue/sdk",
  "version": "0.1.7",
  "description": "Compatibility shim for NoxHere telemetry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No-Box-Dev/NoxHere.git",
    "directory": "services/cue/packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@noxhere/sdk": ">=0.2.0 <1"
  },
  "devDependencies": {
    "@noxhere/sdk": "file:../../../../packages/sdk"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
