{
  "name": "@noxhere/cue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "example:check": "tsc --ignoreConfig --noEmit --strict --target ES2022 --lib ES2022,DOM --module ESNext --moduleResolution Bundler examples/browser/noxcue.ts",
    "sdk:build": "npm run build --workspace @noxcue/sdk",
    "sdk:check": "npm run check --workspace @noxcue/sdk",
    "sdk:contract": "python3 scripts/generate-sdk-contract.py --check",
    "sdk:python:test": "PYTHONPATH=packages/python-sdk/src python3 -m unittest discover -s packages/python-sdk/tests -v",
    "sdk:parity": "npm run sdk:contract && npm run sdk:check && npx vitest run packages/sdk/src/sdk.test.ts && npm run sdk:python:test",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run cf-typegen && npm run typecheck && npm run sdk:build && npm run example:check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-wasm": "^2.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
