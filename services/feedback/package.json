{
  "name": "@noxhere/feedback",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "node ../../scripts/check-node-version.mjs && node ../../scripts/assert-main-release.mjs",
    "build": "node ../../scripts/check-node-version.mjs && wrangler deploy --dry-run --env=\"\"",
    "deploy": "node ../../scripts/check-node-version.mjs && wrangler deploy --env=\"\"",
    "test": "node ../../scripts/check-node-version.mjs && vitest run",
    "types": "node ../../scripts/check-node-version.mjs && wrangler types worker-configuration.d.ts",
    "types:check": "node ../../scripts/check-node-version.mjs && wrangler types worker-configuration.d.ts --check",
    "preinstall": "node ../../scripts/check-node-version.mjs"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
