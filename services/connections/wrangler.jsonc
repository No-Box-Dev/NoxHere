{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "noxhere-connections",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "BUILD_SHA": "development",
    "GITHUB_APP_ID": "3652510",
    "GITHUB_APP_CLIENT_ID": "Iv23liSD7Nx3fmV1OQfr",
    "NOXHERE_OAUTH_CALLBACK_URL": "https://app.noxhere.com/auth/github/callback",
    "FEEDBACK_PUBLIC_URL": "https://app.noxhere.com/api/feedback/public/v1",
    "PLATFORM_EMAIL_FROM": "invites@noxhere.com",
    "FEEDBACK_EMAIL_FROM": "updates@noxhere.com"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "noxhere-platform-production", "database_id": "c94084e6-d0be-423c-8de6-249e7cf8bf25" }
  ],
  "queues": {
    "producers": [
      { "binding": "TASK_QUEUE", "queue": "noxhere-tasks" }
    ]
  },
  "env": {
    "staging": {
      "name": "noxhere-connections-staging",
      "vars": {
        "BUILD_SHA": "development",
        "GITHUB_APP_ID": "3652510",
        "GITHUB_APP_CLIENT_ID": "Iv23liSD7Nx3fmV1OQfr",
        "NOXHERE_OAUTH_CALLBACK_URL": "https://noxhere-staging.jasper-414.workers.dev/auth/github/callback",
        "FEEDBACK_PUBLIC_URL": "https://noxhere-feedback-staging.jasper-414.workers.dev",
        "PLATFORM_EMAIL_FROM": "invites@noxhere.com",
        "FEEDBACK_EMAIL_FROM": "updates@noxhere.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "noxhere-platform-staging",
          "database_id": "3a9d9857-c26d-4421-9fbd-b81f474864d3"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "TASK_QUEUE", "queue": "noxhere-tasks-staging" }
        ]
      }
    }
  }
}
